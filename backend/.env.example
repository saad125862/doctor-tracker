PORT=4000
NODE_ENV=development
# Local docker: mongodb://mongo:27017/doctor_tracker
# Local without docker: mongodb://localhost:27017/doctor_tracker
# Atlas (live): mongodb+srv://USER:PASS@cluster.mongodb.net/doctor_tracker
MONGODB_URI=mongodb://localhost:27017/doctor_tracker
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Enables the one-click "Quick sign in" endpoint. Set to false in real production use.
DEMO_MODE=true
# Admin account created automatically on first boot
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
