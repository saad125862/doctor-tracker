# Root reference only. Real values live in backend/.env and frontend/.env.local (see their .env.example files).
#
# backend/.env       -> PORT, MONGODB_URI, JWT_SECRET, CORS_ORIGIN, ADMIN_EMAIL, ADMIN_PASSWORD
# frontend/.env.local -> BACKEND_URL
#
# Quick start:   cp backend/.env.example backend/.env   then   docker compose up --build
