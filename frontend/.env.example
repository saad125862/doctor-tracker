# Shows the "Quick sign in" button on the login page (the API must also have DEMO_MODE=true)
NEXT_PUBLIC_DEMO_MODE=true

# URL of the Express API. Used at build/start time by the /api rewrite in next.config.js
# Local (npm run dev): http://localhost:4000
# Docker compose:      http://backend:4000 (set automatically)
# Vercel:              https://your-backend.onrender.com
BACKEND_URL=http://localhost:4000
